{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "AWC_BUILD_TESTS": "ON",
        "AWC_BUILD_EXAMPLES": "ON"
      }
    },
    {
      "name": "dev",
      "displayName": "Debug development build",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Optimised release build",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "AWC_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "coverage",
      "displayName": "Coverage instrumented build (lcov)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "AWC_ENABLE_COVERAGE": "ON", "AWC_BUILD_EXAMPLES": "OFF" }
    },
    {
      "name": "tidy",
      "displayName": "Build with clang-tidy on every translation unit",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "AWC_ENABLE_CLANG_TIDY": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "tidy", "configurePreset": "tidy" },
    { "name": "coverage", "configurePreset": "coverage", "targets": ["coverage"] },
    { "name": "format", "configurePreset": "dev", "targets": ["format"] },
    { "name": "format-check", "configurePreset": "dev", "targets": ["format-check"] }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 4 }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 4 }
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        { "type": "configure", "name": "dev" },
        { "type": "build", "name": "dev" },
        { "type": "test", "name": "dev" }
      ]
    },
    {
      "name": "ci",
      "steps": [
        { "type": "configure", "name": "release" },
        { "type": "build", "name": "release" },
        { "type": "test", "name": "release" }
      ]
    }
  ]
}
